# Copy this file to /etc/osleaders/osleaders.env on the Debian laptop.
# Replace every placeholder there. Never commit the populated file.

NODE_ENV=production
DISCORD_TOKEN=REPLACE_WITH_PRODUCTION_BOT_TOKEN
DISCORD_APPLICATION_ID=REPLACE_WITH_PRODUCTION_APPLICATION_ID
DISCORD_PRODUCTION_GUILD_ID=REPLACE_WITH_PRODUCTION_SERVER_ID
DATABASE_URL=postgresql://REPLACE_WITH_USERNAME:REPLACE_WITH_PASSWORD@localhost:5432/REPLACE_WITH_PRODUCTION_DATABASE
DATABASE_POOL_MAX=4
LOG_LEVEL=info
